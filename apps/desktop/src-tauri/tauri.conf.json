{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RealmBox",
  "version": "0.1.0",
  "identifier": "org.realmbox.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "RealmBox", "width": 1140, "height": 820, "minWidth": 780, "minHeight": 650, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Game",
    "shortDescription": "Un monde solo local, simplement.",
    "resources": {
      "../../../addons/RealmBoxCompanions/RealmBoxCompanions.lua": "addons/RealmBoxCompanions/RealmBoxCompanions.lua",
      "../../../addons/RealmBoxCompanions/RealmBoxCompanions.toc": "addons/RealmBoxCompanions/RealmBoxCompanions.toc",
      "../../../addons/RealmBoxCompanions/RealmBoxCompanions.xml": "addons/RealmBoxCompanions/RealmBoxCompanions.xml"
    }
  }
}
