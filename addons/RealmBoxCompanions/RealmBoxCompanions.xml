<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <Script file="RealmBoxCompanions.lua"/>

  <Frame name="RealmBoxCompanionsFrame" parent="UIParent" hidden="true" movable="true" enableMouse="true">
    <Size x="290" y="292"/>
    <Anchors><Anchor point="CENTER" relativePoint="CENTER" x="330" y="0"/></Anchors>
    <Backdrop bgFile="Interface/Tooltips/UI-Tooltip-Background" edgeFile="Interface/Tooltips/UI-Tooltip-Border" tile="true" tileSize="16" edgeSize="12"><BackgroundInsets left="3" right="3" top="3" bottom="3"/></Backdrop>
    <Scripts>
      <OnLoad>RealmBoxCompanions_OnLoad(self)</OnLoad>
      <OnEvent>RealmBoxCompanions_OnEvent(self, event, ...)</OnEvent>
      <OnUpdate>RealmBoxCompanions_OnUpdate(self, elapsed)</OnUpdate>
      <OnShow>RealmBoxCompanions_OnShow()</OnShow>
      <OnHide>RealmBoxCompanions_OnHide()</OnHide>
      <OnDragStart>self:StartMoving()</OnDragStart>
      <OnDragStop>RealmBoxCompanions_OnDragStop(self)</OnDragStop>
    </Scripts>
    <Layers>
      <Layer level="ARTWORK">
        <FontString name="$parentTitle" inherits="GameFontNormalLarge" text="COMPAGNONS"><Anchors><Anchor point="TOP" y="-18"/></Anchors></FontString>
        <FontString name="$parentGroupStatus" inherits="GameFontHighlightSmall" text="Équipe : 0/4"><Size x="250" y="32"/><Anchors><Anchor point="TOP" y="-42"/></Anchors></FontString>
        <FontString name="$parentStatus" inherits="GameFontHighlightSmall" text="Passerelle locale en attente"><Size x="250" y="18"/><Anchors><Anchor point="TOP" y="-72"/></Anchors></FontString>
      </Layer>
    </Layers>
    <Frames>
      <Button name="$parentLanguage" inherits="UIPanelButtonTemplate" text="EN"><Size x="38" y="20"/><Anchors><Anchor point="TOPLEFT" x="10" y="-10"/></Anchors><Scripts><OnClick>RealmBoxCompanions_ToggleLanguage()</OnClick></Scripts></Button>
      <Button name="$parentClose" inherits="UIPanelCloseButton"><Anchors><Anchor point="TOPRIGHT" x="-3" y="-3"/></Anchors></Button>
      <Button name="$parentFormParty" inherits="UIPanelButtonTemplate" text="Former mon équipe"><Size x="240" y="28"/><Anchors><Anchor point="TOP" y="-98"/></Anchors><Scripts><OnClick>RealmBoxCompanions_FormParty()</OnClick></Scripts></Button>
      <Button name="$parentFollow" inherits="UIPanelButtonTemplate" text="Me suivre"><Size x="115" y="24"/><Anchors><Anchor point="TOPLEFT" x="25" y="-138"/></Anchors><Scripts><OnClick>RealmBoxCompanions_Run("follow")</OnClick><OnEnter>RealmBoxCompanions_Action_OnEnter(self, "follow")</OnEnter><OnLeave>GameTooltip:Hide()</OnLeave></Scripts></Button>
      <Button name="$parentAttack" inherits="UIPanelButtonTemplate" text="Attaquer"><Size x="115" y="24"/><Anchors><Anchor point="LEFT" relativeTo="$parentFollow" relativePoint="RIGHT" x="10"/></Anchors><Scripts><OnClick>RealmBoxCompanions_Run("attack")</OnClick><OnEnter>RealmBoxCompanions_Action_OnEnter(self, "attack")</OnEnter><OnLeave>GameTooltip:Hide()</OnLeave></Scripts></Button>
      <Button name="$parentStay" inherits="UIPanelButtonTemplate" text="Attendre ici"><Size x="115" y="24"/><Anchors><Anchor point="TOPLEFT" x="25" y="-172"/></Anchors><Scripts><OnClick>RealmBoxCompanions_Run("stay")</OnClick><OnEnter>RealmBoxCompanions_Action_OnEnter(self, "stay")</OnEnter><OnLeave>GameTooltip:Hide()</OnLeave></Scripts></Button>
      <Button name="$parentRegroup" inherits="UIPanelButtonTemplate" text="Se regrouper"><Size x="115" y="24"/><Anchors><Anchor point="LEFT" relativeTo="$parentStay" relativePoint="RIGHT" x="10"/></Anchors><Scripts><OnClick>RealmBoxCompanions_Run("regroup")</OnClick><OnEnter>RealmBoxCompanions_Action_OnEnter(self, "regroup")</OnEnter><OnLeave>GameTooltip:Hide()</OnLeave></Scripts></Button>
      <Button name="$parentBoost" inherits="UIPanelButtonTemplate" text="Capacités fortes : serveur"><Size x="240" y="24"/><Anchors><Anchor point="TOP" y="-206"/></Anchors><Scripts><OnClick>RealmBoxCompanions_ToggleBoost()</OnClick><OnEnter>RealmBoxCompanions_Action_OnEnter(self, "boost")</OnEnter><OnLeave>GameTooltip:Hide()</OnLeave></Scripts></Button>
      <Button name="$parentLeave" inherits="UIPanelButtonTemplate" text="Libérer l'équipe"><Size x="240" y="24"/><Anchors><Anchor point="TOP" y="-240"/></Anchors><Scripts><OnClick>RealmBoxCompanions_Run("leave")</OnClick><OnEnter>RealmBoxCompanions_Action_OnEnter(self, "leave")</OnEnter><OnLeave>GameTooltip:Hide()</OnLeave></Scripts></Button>
    </Frames>
  </Frame>

  <Button name="RealmBoxCompanionsMinimapButton" parent="Minimap" frameStrata="MEDIUM" enableMouse="true">
    <Size x="32" y="32"/>
    <Layers>
      <Layer level="BACKGROUND"><Texture file="Interface/Minimap/UI-Minimap-Background"><Size x="24" y="24"/><Anchors><Anchor point="CENTER"/></Anchors></Texture></Layer>
      <Layer level="ARTWORK"><Texture name="$parentIcon" file="Interface/Icons/INV_Misc_GroupLooking"><Size x="20" y="20"/><Anchors><Anchor point="CENTER"/></Anchors><TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/></Texture></Layer>
      <Layer level="OVERLAY"><Texture file="Interface/Minimap/MiniMap-TrackingBorder"><Size x="54" y="54"/><Anchors><Anchor point="TOPLEFT" x="0" y="0"/></Anchors></Texture></Layer>
    </Layers>
    <HighlightTexture file="Interface/Minimap/UI-Minimap-ZoomButton-Highlight" alphaMode="ADD"/>
    <Scripts>
      <OnLoad>RealmBoxCompanions_Minimap_OnLoad(self)</OnLoad>
      <OnClick>RealmBoxCompanions_Toggle()</OnClick>
      <OnDragStart>RealmBoxCompanions_Minimap_OnDragStart(self)</OnDragStart>
      <OnDragStop>RealmBoxCompanions_Minimap_OnDragStop(self)</OnDragStop>
      <OnUpdate>RealmBoxCompanions_Minimap_OnUpdate()</OnUpdate>
      <OnEnter>RealmBoxCompanions_Minimap_OnEnter(self)</OnEnter>
      <OnLeave>GameTooltip:Hide()</OnLeave>
    </Scripts>
  </Button>
</Ui>
