---
import type { SiteCopy } from "../content/types";

interface Props { copy: SiteCopy }
const { copy } = Astro.props;
const base = import.meta.env.BASE_URL;
const downloadUrl = "https://github.com/bnjdpn/RealmBox/releases/tag/v0.5.0";
---

<section class="hero">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="kicker"><i></i>{copy.hero.eyebrow}</p>
      <h1>{copy.hero.title}<strong>{copy.hero.accent}</strong></h1>
      <p class="hero-lead">{copy.hero.body}</p>
      <div class="actions">
        <a class="button primary" href={downloadUrl}>{copy.hero.download}<span aria-hidden="true">↓</span></a>
        <a class="button ghost" href="#install">{copy.hero.install}<span aria-hidden="true">↘</span></a>
      </div>
      <p class="release-note">{copy.hero.availability}</p>

    </div>
    <figure class="hero-product">
      <div class="product-heading"><span>RealmBox</span><span>{copy.lang === "fr" ? "Votre monde, prêt à partir" : "Your world, ready to go"}</span></div>
      <img src={`${base}assets/${copy.hero.screenshotAsset}`} width="1024" height="640" alt={copy.hero.screenshotAlt} fetchpriority="high" />
      <figcaption>{copy.hero.screenshotCaption}</figcaption>
    </figure>
  </div>
</section>
