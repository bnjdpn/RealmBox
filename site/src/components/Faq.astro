---
import type { SiteCopy } from "../content/types";

interface Props { copy: SiteCopy }
const { copy } = Astro.props;
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="shell faq-layout">
    <div class="section-intro sticky-intro">
      <p class="kicker">{copy.faq.eyebrow}</p>
      <h2 id="faq-title">{copy.faq.title}</h2>
    </div>
    <div class="accordion">
      {copy.faq.items.map((item, index) => (
        <details open={index === 0}>
          <summary><span>{String(index + 1).padStart(2, "0")}</span>{item.question}<i aria-hidden="true">+</i></summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
