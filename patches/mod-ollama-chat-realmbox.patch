+                                 ambientLimit);
+                    return false;
+                }
+            }
         }

-        g_queue.push_back(std::move(task));
+        if (humanReply)
+        {
+            // Stable priority: preserve FIFO among player replies, but put them
+            // ahead of every queued ambient/background task.
+            auto firstAmbient = std::find_if(g_queue.begin(), g_queue.end(),
+                [](const Task& queued) { return !IsHumanReply(queued); });
+            g_queue.insert(firstAmbient, std::move(task));
+        }
+        else
+        {
+            g_queue.push_back(std::move(task));
+        }
     }

     ++g_totalSubmitted;
