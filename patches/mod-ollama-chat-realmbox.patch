-            return false;
+            if (humanReply && g_queue.size() >= g_MaxQueueDepth)
+            {
+                // The last slot is reserved for a player reply. If older
+                // ambient work filled the queue before this policy was loaded,
+                // evict the newest non-human task rather than the player.
+                auto evict = g_queue.end();
+                for (auto it = g_queue.begin(); it != g_queue.end(); ++it)
+                    if (!IsHumanReply(*it))
+                        evict = it;
+
+                if (evict == g_queue.end())
+                {
+                    ++g_droppedQueueFull;
+                    return false; // bounded even under a flood of player chat
+                }
+
+                g_queue.erase(evict);
+                ++g_droppedQueueFull;
+            }
+            else if (!humanReply)
+            {
+                const size_t ambientLimit = g_MaxQueueDepth > 0
+                    ? static_cast<size_t>(g_MaxQueueDepth - 1)
+                    : 0;
+                if (g_queue.size() >= ambientLimit)
+                {
+                    ++g_droppedQueueFull;
+                    if (g_DebugEnabled)
+                        LOG_INFO("module.ollamachat",
