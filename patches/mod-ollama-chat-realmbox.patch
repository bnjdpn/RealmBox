 }

+void OllamaDispatch_OnConfigReload()
+{
+    uint64_t currentEpoch;
+    size_t queuedRemoved = 0;
+    size_t completedRemoved = 0;
+
+    {
+        std::lock_guard<std::mutex> lock(g_queueMutex);
+        currentEpoch = g_ambientEpoch.fetch_add(1, std::memory_order_acq_rel) + 1;
+
+        const size_t before = g_queue.size();
+        g_queue.erase(std::remove_if(g_queue.begin(), g_queue.end(), IsAmbientChat),
+                      g_queue.end());
+        queuedRemoved = before - g_queue.size();
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(g_doneMutex);
+        const size_t before = g_done.size();
+        g_done.erase(
+            std::remove_if(g_done.begin(), g_done.end(),
+                [currentEpoch](const Completion& completion)
+                {
+                    return !completion.request.recordHistory &&
+                           completion.ambientEpoch != currentEpoch;
+                }),
+            g_done.end());
+        completedRemoved = before - g_done.size();
+    }
+
+    if (g_DebugEnabled && (queuedRemoved > 0 || completedRemoved > 0))
+        LOG_INFO("module.ollamachat",
+                 "[Ollama Chat] Config reload invalidated {} queued and {} completed ambient request(s).",
+                 queuedRemoved, completedRemoved);
+}
