{
  "name": "realmbox",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --dir apps/desktop tauri dev",
    "dev:preview": "pnpm --dir apps/desktop dev",
    "build": "pnpm --dir apps/desktop build",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "capture:launcher": "node scripts/capture-launcher.mjs",
    "test": "pnpm --dir apps/desktop test && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm --dir apps/desktop typecheck",
    "lint": "pnpm --dir apps/desktop lint",
    "check:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:release": "cargo xtask release check",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm site:build && pnpm check:rust && pnpm check:release"
  },
  "devDependencies": {
    "fengari": "0.1.5",
    "playwright": "1.62.1"
  }
}
