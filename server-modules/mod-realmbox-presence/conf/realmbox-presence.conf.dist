[worldserver]

# Enable gradual placement of autonomous random bots around real players.
RealmBoxPresence.Enabled = 1

# Re-evaluate presence every second and move at most one bot per pass.
# This fills the player's surroundings quickly while keeping the work bounded.
RealmBoxPresence.ScanIntervalMs = 1000
RealmBoxPresence.MaxMovesPerScan = 1
RealmBoxPresence.PlayerCooldownSeconds = 0

# Target a majority of every autonomous bot online, split across real players,
# then cap the result to the friendly population. With one Alliance player and
# 50 autonomous bots (27 Alliance), 0.60 asks for 30 and safely converges toward
# all 27 friendly bots instead of bringing hostile Horde bots into Stormwind.
RealmBoxPresence.TargetFraction = 0.60
RealmBoxPresence.MinBotsPerPlayer = 4
RealmBoxPresence.MaxBotsPerPlayer = 30
RealmBoxPresence.NearbyRadius = 150.0

# Place newcomers on reachable ground in the player's current zone. The inner
# radius keeps newcomers close enough to become visible during the initial load.
RealmBoxPresence.SpawnMinRadius = 30.0
RealmBoxPresence.SpawnMaxRadius = 90.0
RealmBoxPresence.SameZoneOnly = 1
RealmBoxPresence.PointAttempts = 12

# Do not make a bot disappear in front of another player, and do not repeatedly
# shuttle the same bot between players. A bot released by a disband receives an
# additional grace period and immediately resumes its autonomous strategies.
RealmBoxPresence.DisappearanceGuardRadius = 150.0
RealmBoxPresence.BotCooldownSeconds = 10
RealmBoxPresence.ReleasedBotGraceSeconds = 300

# 0 disables level filtering. Set a positive value to keep ambience bots within
# that many levels of the player.
RealmBoxPresence.MaxLevelDelta = 0
